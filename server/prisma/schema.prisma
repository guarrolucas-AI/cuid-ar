generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  role                String
  status              String               @default("active")
  createdAt           DateTime             @default(now())
  // Identificación — PRIVADO: solo visible por el propio usuario y el admin
  dni                 String?
  cuil                String?
  // Consentimiento Ley 25.326 para procesamiento de datos y antecedentes
  consentimientoAntecedentes Boolean   @default(false)
  fechaConsentimiento        DateTime?
  ipRegistro                 String?
  // Fecha en que el usuario activó su suscripción (pagó). Sirve para calcular
  // el vencimiento de 5 días para presentar el certificado de antecedentes.
  subscribedAt               DateTime?
  professional        Professional?
  parent              Parent?
  passwordResetTokens PasswordResetToken[]
  identityCheck       IdentityCheck?
}

model Professional {
  userId          String           @id
  user            User             @relation(fields: [userId], references: [id])
  name            String
  phone           String
  zone            String
  // DEPRECATED — reemplazado por `categories` (String[]) para permitir más
  // de un servicio por profesional. Se deja la columna sin usar en vez de
  // borrarla (evita un drop destructivo sobre datos reales); no la lee ni
  // la escribe ningún endpoint desde el cambio a multi-especialidad.
  category        String?
  // Un profesional puede ofrecer más de un servicio (ej. cuidado infantil
  // + limpieza). ContactRequest/Conversation siguen guardando un único
  // category — cuál de esos servicios puntuales fue la consulta.
  categories      String[]         @default([])
  verified        Boolean          @default(false)
  hourlyRate      Float
  available       Boolean          @default(true)
  onDuty          Boolean          @default(false)
  photoUrl        String?
  certifications  String[]         @default([])
  address         String?
  lat             Float?
  lng             Float?
  bio             String?
  travelRadiusKm  Float?           @default(15)
  contactRequests ContactRequest[]
  conversations   Conversation[]
  applications    JobApplication[]
  alertConfig     ProfessionalAlertConfig?
  notifications   Notification[]
  credentials     ProfessionalCredential[]
}

model Parent {
  userId          String           @id
  user            User             @relation(fields: [userId], references: [id])
  name            String
  phone           String
  address         String
  lat             Float?
  lng             Float?
  maxDistanceKm   Float?           @default(15)
  contactRequests ContactRequest[]
  conversations   Conversation[]
  jobPosts        JobPost[]
}

model ContactRequest {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [userId])
  professionalId String
  parent         Parent       @relation(fields: [parentId], references: [userId])
  parentId       String
  category       String
  createdAt      DateTime     @default(now())
}

// Match / chat / cierre de contratación. Un solo hilo por par
// profesional-padre (no uno nuevo por cada categoría que consulten) para
// que el historial quede unificado, estilo red social.
model Conversation {
  id                       String    @id @default(uuid())
  professional             Professional @relation(fields: [professionalId], references: [userId])
  professionalId           String
  parent                   Parent    @relation(fields: [parentId], references: [userId])
  parentId                 String
  category                 String
  status                   String    @default("open") // open | agreed
  agreedByProfessional     Boolean   @default(false)
  agreedByParent           Boolean   @default(false)
  agreedAt                 DateTime?
  // "Borrar historial" es individual: cada quien puede limpiar su propia
  // vista sin borrar los mensajes para la otra parte.
  clearedAtForProfessional DateTime?
  clearedAtForParent       DateTime?
  createdAt                DateTime  @default(now())
  messages                 Message[]

  @@unique([professionalId, parentId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  senderId       String
  body           String
  // Adjunto opcional (foto o PDF), guardado en el store privado de Vercel
  // Blob. attachmentPathname es la clave dentro del store — nunca se
  // guarda ni se expone una URL pública, la descarga siempre pasa por
  // /api/chat/attachments/:pathname que valida membership de la conversación.
  attachmentPathname String?
  attachmentType     String?
  attachmentName     String?
  createdAt      DateTime     @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AppConfig {
  key       String   @id
  value     String
  label     String
  sensitive Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Tarifa de referencia oficial por categoría, cargada y mantenida por el
// admin (nomencladores AFIP/CNTP/Salud) — ver "Módulo de Gestión de
// Aranceles". officialRate nullable a propósito: sin configurar todavía
// se muestra como tal en vez de un $0 engañoso.
model ServiceRate {
  category            String   @id
  officialRate        Float?
  // Valor mensual "con retiro" de la misma fuente — solo lo completa el
  // fetcher de ARCA (Casas Particulares), null para categorías de carga
  // manual sin ese dato.
  officialRateMonthly Float?
  // De dónde salió el valor: "Manual" (lo cargó el admin a mano) o la
  // fuente oficial usada por el fetcher automático (ej. "ARCA (Casas
  // Particulares) — vigente julio 2026"). Puramente informativo.
  source              String?
  updatedAt           DateTime @updatedAt
}

// Auditoría de acciones del admin (verificaciones, altas/bajas de
// suscripción, cambios de aranceles y de configuración) — trazabilidad
// de "quién hizo qué y cuándo" en el backoffice.
model JobPost {
  id           String           @id @default(uuid())
  parent       Parent           @relation(fields: [parentId], references: [userId])
  parentId     String
  category     String
  zone         String
  days         String[]         @default([])
  schedule     String
  modality     String
  requirements String[]         @default([])
  notes        String?
  status       String           @default("active")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id             String       @id @default(uuid())
  jobPost        JobPost      @relation(fields: [jobPostId], references: [id])
  jobPostId      String
  professional   Professional @relation(fields: [professionalId], references: [userId])
  professionalId String
  status         String       @default("pending")
  createdAt      DateTime     @default(now())

  @@unique([jobPostId, professionalId])
}

model ProfessionalAlertConfig {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [userId])
  professionalId String       @unique
  zones          String[]     @default([])
  categories     String[]     @default([])
  active         Boolean      @default(true)
  updatedAt      DateTime     @updatedAt
}

model Notification {
  id             String       @id @default(uuid())
  professional   Professional @relation(fields: [professionalId], references: [userId])
  professionalId String
  type           String       @default("job_alert")
  title          String
  body           String
  jobPostId      String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// Matrícula o credencial habilitante. Solo para categorías que la requieren
// (salud, terapeutico). Visible al propio profesional y al admin; nunca al público.
model ProfessionalCredential {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [userId])
  type           String       // "matricula_nacional" | "matricula_provincial"
  number         String
  province       String?      // solo si type = "matricula_provincial"
  verifiedAt     DateTime?
  verifiedBy     String?      // email del admin que verificó
  createdAt      DateTime     @default(now())

  @@index([professionalId])
}

// Verificación de antecedentes y estado de identidad.
// status: "pending" | "clear" | "flagged" | "manual_review"
// Solo visible al propio usuario (su estado) y al admin (todo, incluyendo el PDF).
model IdentityCheck {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  status         String    @default("pending")
  requestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?
  // Ruta del PDF del Certificado de Antecedentes Penales en el store privado.
  // Nunca se expone fuera del endpoint admin — solo el admin puede descargarlo.
  certificadoUrl String?
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())
}
