{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/rates",
      "schedule": "0 12 3 * *"
    },
    {
      "path": "/api/cron/suspend-overdue",
      "schedule": "0 6 * * *"
    }
  ]
}
